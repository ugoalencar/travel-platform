{
  "name": "travel-platform",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS travel platform monorepo for agencies, brokers, and customers.",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint .ai scripts tests eslint.config.js vitest.config.ts vitest.database.config.ts",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit && turbo run typecheck",
    "test": "turbo run test",
    "test:db": "vitest run --config vitest.database.config.ts",
    "test:security": "vitest run tests/security",
    "test:coverage": "turbo run test:coverage",
    "security:check": "node scripts/check-security-audit.cjs",
    "secrets:scan": "node scripts/check-secrets.cjs",
    "migrations:validate": "node scripts/validate-migrations.cjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "clean": "turbo run clean",
    "recovery:drill": "node scripts/recovery-drill.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@prisma/client": "^6.14.0",
    "fastify": "^5.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "prettier": "^3.6.0",
    "prisma": "^6.14.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
