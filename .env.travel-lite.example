# Travel Lite — configuração local (copie para .env.travel-lite, que é gitignored).
#
#   Copy-Item .env.travel-lite.example .env.travel-lite
#
# Nenhum valor real deve ser commitado neste repositório.

# Senha do superuser local do PostgreSQL (compose + migrations + backup).
# Deixe vazio para usar a senha padrão de desenvolvimento local.
TRAVEL_LITE_DB_PASSWORD=

# Senha de login do seed da agência (obrigatória apenas para
# scripts/travel-lite-seed-gadotti.cjs). Nenhuma senha é hardcoded no repo.
TRAVEL_LITE_SEED_PASSWORD=
