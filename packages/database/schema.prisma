generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// MULTI-TENANT: Agency = Tenant
// REGRA: USER -> AGENCY -> RESOURCE
// Nunca: USER -> RESOURCE
// ============================================================

model Agency {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  cnpj      String?  @unique
  email     String?
  phone     String?
  address   Json?
  settings  Json?
  plan      Plan     @default(FREE)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            User[]
  brokers          Broker[]
  customers        Customer[]
  customerAccounts CustomerAccount[]
  wishes           Wish[]
  trips            Trip[]
  offers           Offer[]
  proposals        Proposal[]
  sales            Sale[]
  commissions      Commission[]

  @@map("agencies")
}

model User {
  id           String    @id @default(uuid())
  agencyId     String    @map("agency_id")
  email        String
  name         String
  role         UserRole
  passwordHash String    @map("password_hash")
  status       Status    @default(ACTIVE)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  proposals   Proposal[]
  sales       Sale[]
  commissions Commission[]

  @@unique([agencyId, email])
  @@unique([agencyId, id])
  @@index([agencyId])
  @@map("users")
}

model Broker {
  id         String   @id @default(uuid())
  agencyId   String   @map("agency_id")
  name       String
  email      String
  phone      String?
  commission Decimal  @default(0) @db.Decimal(5, 2)
  status     Status   @default(ACTIVE)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  sales       Sale[]
  commissions Commission[]

  @@unique([agencyId, email])
  @@unique([agencyId, id])
  @@index([agencyId])
  @@map("brokers")
}

model Customer {
  id        String    @id @default(uuid())
  agencyId  String    @map("agency_id")
  name      String
  email     String?
  phone     String?
  cpf       String?
  passport  String?
  address   Json?
  notes     String?
  status    Status    @default(ACTIVE)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  agency    Agency           @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  account   CustomerAccount?
  wishes    Wish[]
  proposals Proposal[]
  sales     Sale[]
  trips     Trip[]

  // Migration 001 must enforce active-customer uniqueness with partial indexes:
  // (agency_id, cpf) WHERE cpf IS NOT NULL AND deleted_at IS NULL
  // (agency_id, email) WHERE email IS NOT NULL AND deleted_at IS NULL
  @@unique([agencyId, id])
  @@index([agencyId])
  @@index([agencyId, cpf])
  @@index([agencyId, email])
  @@index([agencyId, name])
  @@map("customers")
}

model CustomerAccount {
  id           String                @id @default(uuid())
  agencyId     String                @map("agency_id")
  customerId   String                @map("customer_id")
  email        String
  passwordHash String                @map("password_hash")
  status       CustomerAccountStatus @default(ACTIVE)
  lastLoginAt  DateTime?             @map("last_login_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  agency   Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [agencyId, customerId], references: [agencyId, id], onDelete: Restrict)

  @@unique([agencyId, email])
  @@unique([agencyId, customerId])
  @@index([agencyId])
  @@map("customer_accounts")
}

model Wish {
  id             String     @id @default(uuid())
  agencyId       String     @map("agency_id")
  customerId     String     @map("customer_id")
  destination    String?
  startDate      DateTime?  @map("start_date") @db.Date
  endDate        DateTime?  @map("end_date") @db.Date
  budget         Decimal?   @db.Decimal(10, 2)
  travelersCount Int?       @map("travelers_count")
  notes          String?
  status         WishStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  agency    Agency     @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  customer  Customer   @relation(fields: [agencyId, customerId], references: [agencyId, id], onDelete: Restrict)
  proposals Proposal[]

  @@unique([agencyId, id])
  @@index([agencyId])
  @@index([agencyId, customerId])
  @@index([agencyId, status])
  @@index([agencyId, startDate])
  @@map("wishes")
}

model Offer {
  id          String      @id @default(uuid())
  agencyId    String      @map("agency_id")
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  validFrom   DateTime?   @map("valid_from")
  validUntil  DateTime?   @map("valid_until")
  status      OfferStatus @default(ACTIVE)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  agency    Agency     @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  proposals Proposal[]

  @@unique([agencyId, id])
  @@index([agencyId])
  @@index([agencyId, status])
  @@index([agencyId, validUntil])
  @@map("offers")
}

model Proposal {
  id            String         @id @default(uuid())
  agencyId      String         @map("agency_id")
  customerId    String         @map("customer_id")
  offerId       String?        @map("offer_id")
  wishId        String?        @map("wish_id")
  userId        String?        @map("user_id")
  proposedPrice Decimal        @map("proposed_price") @db.Decimal(10, 2)
  discount      Decimal        @default(0) @db.Decimal(10, 2)
  total         Decimal        @db.Decimal(10, 2)
  validUntil    DateTime?      @map("valid_until")
  conditions    String?
  notes         String?
  status        ProposalStatus @default(DRAFT)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  agency   Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [agencyId, customerId], references: [agencyId, id], onDelete: Restrict)
  offer    Offer?   @relation(fields: [agencyId, offerId], references: [agencyId, id], onDelete: Restrict)
  wish     Wish?    @relation(fields: [agencyId, wishId], references: [agencyId, id], onDelete: Restrict)
  user     User?    @relation(fields: [agencyId, userId], references: [agencyId, id], onDelete: Restrict)
  sale     Sale?

  @@unique([agencyId, id])
  @@index([agencyId])
  @@index([agencyId, customerId])
  @@index([agencyId, status])
  @@index([agencyId, validUntil])
  @@map("proposals")
}

model Sale {
  id         String     @id @default(uuid())
  agencyId   String     @map("agency_id")
  customerId String     @map("customer_id")
  proposalId String?    @map("proposal_id")
  brokerId   String?    @map("broker_id")
  userId     String     @map("user_id")
  amount     Decimal    @db.Decimal(10, 2)
  discount   Decimal    @default(0) @db.Decimal(10, 2)
  total      Decimal    @db.Decimal(10, 2)
  status     SaleStatus @default(PENDING)
  notes      String?
  paidAt     DateTime?  @map("paid_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  customer    Customer     @relation(fields: [agencyId, customerId], references: [agencyId, id], onDelete: Restrict)
  proposal    Proposal?    @relation(fields: [agencyId, proposalId], references: [agencyId, id], onDelete: Restrict)
  broker      Broker?      @relation(fields: [agencyId, brokerId], references: [agencyId, id], onDelete: Restrict)
  user        User         @relation(fields: [agencyId, userId], references: [agencyId, id], onDelete: Restrict)
  trip        Trip?
  commissions Commission[]

  @@unique([agencyId, id])
  @@unique([agencyId, proposalId])
  @@index([agencyId])
  @@index([agencyId, customerId])
  @@index([agencyId, status])
  @@index([agencyId, createdAt])
  @@map("sales")
}

model Commission {
  id         String           @id @default(uuid())
  agencyId   String           @map("agency_id")
  saleId     String           @map("sale_id")
  brokerId   String?          @map("broker_id")
  userId     String?          @map("user_id")
  amount     Decimal          @db.Decimal(10, 2)
  percentage Decimal?         @db.Decimal(5, 2)
  status     CommissionStatus @default(PENDING)
  paidAt     DateTime?        @map("paid_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  agency Agency  @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  sale   Sale    @relation(fields: [agencyId, saleId], references: [agencyId, id], onDelete: Restrict)
  broker Broker? @relation(fields: [agencyId, brokerId], references: [agencyId, id], onDelete: Restrict)
  user   User?   @relation(fields: [agencyId, userId], references: [agencyId, id], onDelete: Restrict)

  @@index([agencyId])
  @@index([agencyId, saleId])
  @@index([agencyId, status])
  @@map("commissions")
}

model Trip {
  id          String     @id @default(uuid())
  agencyId    String     @map("agency_id")
  customerId  String     @map("customer_id")
  saleId      String?    @map("sale_id")
  name        String
  destination String
  description String?
  startDate   DateTime   @map("start_date") @db.Date
  endDate     DateTime   @map("end_date") @db.Date
  status      TripStatus @default(PLANNED)
  notes       String?
  metadata    Json?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  agency   Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [agencyId, customerId], references: [agencyId, id], onDelete: Restrict)
  sale     Sale?    @relation(fields: [agencyId, saleId], references: [agencyId, id], onDelete: Restrict)

  @@unique([agencyId, saleId])
  @@index([agencyId])
  @@index([agencyId, customerId])
  @@index([agencyId, status])
  @@index([agencyId, startDate])
  @@map("trips")
}

// ============================================================
// ENUMS
// ============================================================

enum Plan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
  VIEWER
}

enum CustomerAccountStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum WishStatus {
  ACTIVE
  MATCHED
  PROPOSED
  FULFILLED
  EXPIRED
  CANCELLED
}

enum OfferStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum SaleStatus {
  PENDING
  CONFIRMED
  PAID
  CANCELLED
  REFUNDED
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

enum TripStatus {
  PLANNED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
