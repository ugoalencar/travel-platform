  rawPayload       Json?          @map("raw_payload")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  agency      Agency                 @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "engagements_agency_fk")
