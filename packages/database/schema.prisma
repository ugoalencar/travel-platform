model Route {
  id                String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId          String             @map("agency_id")
  origin            String
  destination       String
  estimatedDuration Int?               @map("estimated_duration")
  distance          Decimal?           @db.Decimal(10, 2)
  notes             String?
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  agency            Agency             @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "routes_agency_fk")
  outboundProducts  TransportProduct[] @relation("ProductOutboundRoute")
  returnProducts    TransportProduct[] @relation("ProductReturnRoute")
  points            RoutePoint[]

  @@unique([agencyId, id], map: "routes_agency_id_key")
  @@index([agencyId], map: "routes_agency_idx")
  @@index([agencyId, active], map: "routes_agency_active_idx")
  @@map("routes")
}

// RoutePoint: an ordered itinerary point on a Route. Check-in is
// optional per point (checkpointRequired); see 004_route_points.sql
// for the full scope-decision notes.
model RoutePoint {
  id                   String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId             String                @map("agency_id")
  routeId              String                @map("route_id")
  sequence             Int
  name                 String
  checkpointRequired   Boolean               @default(false) @map("checkpoint_required")
  checkpointType       CheckpointType?       @map("checkpoint_type")
  // Minutes after the future ScheduledDeparture's departureAt. Not an
  // absolute time; expected-absolute-time (departureAt + offset) is a
  // future derivation, not stored here.
  plannedOffsetMinutes Int?                  @map("planned_offset_minutes")
  notes                String?
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  agency               Agency                @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "route_points_agency_fk")
  route                Route                 @relation(fields: [agencyId, routeId], references: [agencyId, id], onDelete: Restrict, map: "route_points_route_tenant_fk")
  operationCheckpoints OperationCheckpoint[]

  // NOTE: route_points_checkpoint_type_required_check (SQL CHECK)
  // enforces checkpointRequired/checkpointType consistency at the
  // database layer; Prisma cannot express cross-column CHECK
  // constraints, so this file cannot describe it directly (same
  // limitation as the other CHECK constraints noted elsewhere in this
  // file).

  @@unique([agencyId, id], map: "route_points_agency_id_key")
  @@unique([agencyId, routeId, sequence], map: "route_points_agency_route_sequence_key")
  @@index([agencyId], map: "route_points_agency_idx")
  @@index([agencyId, routeId, sequence], map: "route_points_agency_route_sequence_idx")
  @@map("route_points")
}

model Supplier {
  id         String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId   String               @map("agency_id")
  name       String
  document   String?
  contact    String?
  active     Boolean              @default(true)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  agency     Agency               @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "suppliers_agency_fk")
  departures ScheduledDeparture[]
  payables   Payable[]
  operationalCosts OperationalCost[]

  @@unique([agencyId, id], map: "suppliers_agency_id_key")
  @@index([agencyId], map: "suppliers_agency_idx")
  @@index([agencyId, active], map: "suppliers_agency_active_idx")
  @@map("suppliers")
}

model TransportProduct {
  id               String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId         String               @map("agency_id")
  name             String
  tripType         TripType             @map("trip_type")
  outboundRouteId  String               @map("outbound_route_id")
  returnRouteId    String?              @map("return_route_id")
  price            Decimal              @db.Decimal(10, 2)
  active           Boolean              @default(true)
  publiclyBookable Boolean              @default(false) @map("publicly_bookable")
  notes            String?
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  agency           Agency               @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "transport_products_agency_fk")
  departures       ScheduledDeparture[]
  outboundRoute    Route                @relation("ProductOutboundRoute", fields: [agencyId, outboundRouteId], references: [agencyId, id], onDelete: Restrict, map: "transport_products_outbound_route_tenant_fk")
  // returnRouteId is nullable: same SetNull-by-default risk noted on
  // Proposal/Sale/Commission/Trip above. Explicit onDelete: Restrict
  // here is required for this file to be accurate.
  returnRoute      Route?               @relation("ProductReturnRoute", fields: [agencyId, returnRouteId], references: [agencyId, id], onDelete: Restrict, map: "transport_products_return_route_tenant_fk")

  // NOTE: transport_products_return_route_required_check (SQL CHECK)
  // enforces trip_type/return_route_id consistency at the database
  // layer; Prisma cannot express cross-column CHECK constraints, so
  // this file cannot describe it directly (same limitation as the
  // other CHECK constraints noted at the top of this file).
  @@unique([agencyId, id], map: "transport_products_agency_id_key")
  @@index([agencyId], map: "transport_products_agency_idx")
  @@index([agencyId, outboundRouteId], map: "transport_products_agency_outbound_route_idx")
  @@index([agencyId, returnRouteId], map: "transport_products_agency_return_route_idx")
  @@index([agencyId, active], map: "transport_products_agency_active_idx")
  @@index([agencyId, publiclyBookable], map: "transport_products_agency_publicly_bookable_idx")
  @@map("transport_products")
}

model ScheduledDeparture {
  id                String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId          String               @map("agency_id")
  productId         String               @map("product_id")
  departureAt       DateTime             @map("departure_at") @db.Timestamptz(6)
  arrivalExpectedAt DateTime?            @map("arrival_expected_at") @db.Timestamptz(6)
  capacity          Int
  supplierId        String?              @map("supplier_id")
  serviceType       DepartureServiceType @map("service_type")
  // No SCHEDULED/DEPARTED/CANCELLED/COMPLETED lifecycle enum exists
  // (no approved decision). This boolean exists only because it is
  // mechanically necessary for the "hard capacity limit" rule to be
  // meaningful once Booking exists (a cancelled departure must not
  // count toward availability) -- see 003_transportation.sql.
  cancelled         Boolean              @default(false)
  notes             String?
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  agency            Agency               @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "scheduled_departures_agency_fk")
  product           TransportProduct     @relation(fields: [agencyId, productId], references: [agencyId, id], onDelete: Restrict, map: "scheduled_departures_product_tenant_fk")
  // supplierId is nullable: same SetNull-by-default risk noted above.
  supplier          Supplier?            @relation(fields: [agencyId, supplierId], references: [agencyId, id], onDelete: Restrict, map: "scheduled_departures_supplier_tenant_fk")
  outboundBookings  Booking[]            @relation("BookingOutboundDeparture")
  returnBookings    Booking[]            @relation("BookingReturnDeparture")
  operation         TransportOperation?  @relation("ScheduledDeparture_operation")

  @@unique([agencyId, id], map: "scheduled_departures_agency_id_key")
  @@index([agencyId], map: "scheduled_departures_agency_idx")
  @@index([agencyId, productId, departureAt], map: "scheduled_departures_agency_product_departure_idx")
  @@index([agencyId, supplierId], map: "scheduled_departures_agency_supplier_idx")
  @@index([agencyId, departureAt], map: "scheduled_departures_agency_departure_at_idx")
  @@map("scheduled_departures")
}

// Booking: the operational reservation. See 005_booking.sql for full
// scope-decision rationale (no Sale-like pricing fields, no invented
// lifecycle beyond a capacity-relevant `cancelled` boolean).
model Booking {
  id                  String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId            String                @map("agency_id")
  bookerCustomerId    String                @map("booker_customer_id")
  tripType            TripType              @map("trip_type")
  outboundDepartureId String                @map("outbound_departure_id")
  returnDepartureId   String?               @map("return_departure_id")
  cancelled           Boolean               @default(false)
  cancelledAt         DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  cancelledByUserId   String?               @map("cancelled_by_user_id")
  cancellationReason  String?               @map("cancellation_reason")
  notes               String?
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  agency              Agency                @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "bookings_agency_fk")
  bookerCustomer      Customer              @relation(fields: [agencyId, bookerCustomerId], references: [agencyId, id], onDelete: Restrict, map: "bookings_booker_customer_tenant_fk")
  outboundDeparture   ScheduledDeparture    @relation("BookingOutboundDeparture", fields: [agencyId, outboundDepartureId], references: [agencyId, id], onDelete: Restrict, map: "bookings_outbound_departure_tenant_fk")
  returnDeparture     ScheduledDeparture?   @relation("BookingReturnDeparture", fields: [agencyId, returnDepartureId], references: [agencyId, id], onDelete: Restrict, map: "bookings_return_departure_tenant_fk")
  cancelledByUser     User?                 @relation("BookingCancelledByUser", fields: [agencyId, cancelledByUserId], references: [agencyId, id], onDelete: Restrict, map: "bookings_cancelled_by_user_tenant_fk")
  passengers          BookingPassenger[]

  @@unique([agencyId, id], map: "bookings_agency_id_key")
  @@index([agencyId], map: "bookings_agency_idx")
  @@index([agencyId, outboundDepartureId], map: "bookings_agency_outbound_departure_idx")
  @@index([agencyId, returnDepartureId], map: "bookings_agency_return_departure_idx")
  @@index([agencyId, bookerCustomerId], map: "bookings_agency_booker_idx")
  @@index([agencyId, cancelled, cancelledAt], map: "bookings_agency_cancelled_idx")
  @@map("bookings")
}

// Minimal passenger identity only -- NOT a Customer (no FK to
// customers). See 005_booking.sql.
model BookingPassenger {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId   String   @map("agency_id")
  bookingId  String   @map("booking_id")
  name       String
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "booking_passengers_agency_fk")
  booking    Booking  @relation(fields: [agencyId, bookingId], references: [agencyId, id], onDelete: Restrict, map: "booking_passengers_booking_tenant_fk")

  @@unique([agencyId, id], map: "booking_passengers_agency_id_key")
  @@index([agencyId], map: "booking_passengers_agency_idx")
  @@index([agencyId, bookingId], map: "booking_passengers_agency_booking_idx")
  @@map("booking_passengers")
}

// TransportOperation: a thin "this ScheduledDeparture is now being
// operated" marker (EXECUTION), distinct from ScheduledDeparture
// (PLAN). At most one Operation per Departure. OperationCheckpoint
// rows hang off this join point. See 005_field_operations.sql for the
// full scope-decision notes.
model TransportOperation {
  id          String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId    String                @map("agency_id")
  departureId String                @map("departure_id")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  agency      Agency                @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "transport_operations_agency_fk")
  departure   ScheduledDeparture    @relation("ScheduledDeparture_operation", fields: [agencyId, departureId], references: [agencyId, id], onDelete: Restrict, map: "transport_operations_departure_tenant_fk")
  checkpoints OperationCheckpoint[]
  assignments OperationAssignment[]
  payables    Payable[]
  operationalCosts OperationalCost[]

  @@unique([agencyId, id], map: "transport_operations_agency_id_key")
  @@unique([agencyId, departureId], map: "transport_operations_agency_departure_key")
  @@index([agencyId], map: "transport_operations_agency_idx")
  @@index([agencyId, departureId], map: "transport_operations_agency_departure_idx")
  @@map("transport_operations")
}

// OperationCheckpoint: EXECUTION record generated from a RoutePoint
// with checkpointRequired = true when a TransportOperation is created.
// checkpointType is snapshotted from the RoutePoint at generation
// time. arrivalCheckedAt/departureCheckedAt are separate nullable
// columns set only by a server-side confirmation action (never
// client-supplied, never pre-filled). expectedAt/delay are NOT
// persisted -- both are derived on read by the application layer.
model OperationCheckpoint {
  id                 String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId           String             @map("agency_id")
  operationId        String             @map("operation_id")
  routePointId       String             @map("route_point_id")
  checkpointType     CheckpointType     @map("checkpoint_type")
  arrivalCheckedAt   DateTime?          @map("arrival_checked_at") @db.Timestamptz(6)
  departureCheckedAt DateTime?          @map("departure_checked_at") @db.Timestamptz(6)
  arrivalConfirmedByUserId   String?    @map("arrival_confirmed_by_user_id")
  departureConfirmedByUserId String?    @map("departure_confirmed_by_user_id")
  arrivalOperationalStaffId  String?    @map("arrival_operational_staff_id")
  departureOperationalStaffId String?   @map("departure_operational_staff_id")
  notes              String?
  // Optional, manual-entry-only free text. No GPS/geofencing.
  location           String?
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  agency             Agency             @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "operation_checkpoints_agency_fk")
  operation          TransportOperation @relation(fields: [agencyId, operationId], references: [agencyId, id], onDelete: Restrict, map: "operation_checkpoints_operation_tenant_fk")
  routePoint         RoutePoint         @relation(fields: [agencyId, routePointId], references: [agencyId, id], onDelete: Restrict, map: "operation_checkpoints_route_point_tenant_fk")
  arrivalConfirmedByUser User?          @relation("OperationCheckpointArrivalConfirmedBy", fields: [agencyId, arrivalConfirmedByUserId], references: [agencyId, id], onDelete: Restrict, map: "operation_checkpoints_arrival_confirmed_by_user_tenant_fk")
  departureConfirmedByUser User?        @relation("OperationCheckpointDepartureConfirmedBy", fields: [agencyId, departureConfirmedByUserId], references: [agencyId, id], onDelete: Restrict, map: "operation_checkpoints_departure_confirmed_by_user_tenant_fk")
  arrivalOperationalStaff OperationalStaff? @relation("OperationCheckpointArrivalOperationalStaff", fields: [agencyId, arrivalOperationalStaffId], references: [agencyId, id], onDelete: Restrict, map: "operation_checkpoints_arrival_operational_staff_tenant_fk")
  departureOperationalStaff OperationalStaff? @relation("OperationCheckpointDepartureOperationalStaff", fields: [agencyId, departureOperationalStaffId], references: [agencyId, id], onDelete: Restrict, map: "operation_checkpoints_departure_operational_staff_tenant_fk")

  // NOTE: operation_checkpoints_arrival_type_check /
  // operation_checkpoints_departure_type_check (SQL CHECK constraints)
  // enforce checkpointType/timestamp consistency at the database
  // layer; Prisma cannot express cross-column CHECK constraints, same
  // limitation noted elsewhere in this file.

  @@unique([agencyId, id], map: "operation_checkpoints_agency_id_key")
  @@unique([agencyId, operationId, routePointId], map: "operation_checkpoints_agency_operation_point_key")
  @@index([agencyId], map: "operation_checkpoints_agency_idx")
  @@index([agencyId, operationId], map: "operation_checkpoints_agency_operation_idx")
  @@index([agencyId, routePointId], map: "operation_checkpoints_agency_route_point_idx")
  @@map("operation_checkpoints")
}

model OperationalStaff {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId    String   @map("agency_id")
  userId      String?  @map("user_id")
  name        String
  phone       String?
  email       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "operational_staff_agency_fk")
  user        User?    @relation(fields: [agencyId, userId], references: [agencyId, id], onDelete: Restrict, map: "operational_staff_user_tenant_fk")
  capabilities OperationalStaffCapabilityEntry[]
  assignments OperationAssignment[]
  arrivalConfirmations OperationCheckpoint[] @relation("OperationCheckpointArrivalOperationalStaff")
  departureConfirmations OperationCheckpoint[] @relation("OperationCheckpointDepartureOperationalStaff")

  @@unique([agencyId, id], map: "operational_staff_agency_id_key")
  @@unique([agencyId, userId], map: "operational_staff_agency_user_key")
  @@index([agencyId], map: "operational_staff_agency_idx")
  @@index([agencyId, userId], map: "operational_staff_agency_user_idx")
  @@map("operational_staff")
}

model OperationalStaffCapabilityEntry {
  id                 String                     @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId           String                     @map("agency_id")
  operationalStaffId String                     @map("operational_staff_id")
  capability         OperationalStaffCapability
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  agency             Agency                     @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "operational_staff_capabilities_agency_fk")
  operationalStaff   OperationalStaff           @relation(fields: [agencyId, operationalStaffId], references: [agencyId, id], onDelete: Restrict, map: "operational_staff_capabilities_staff_tenant_fk")

  @@unique([agencyId, id], map: "operational_staff_capabilities_agency_id_key")
  @@unique([agencyId, operationalStaffId, capability], map: "operational_staff_capabilities_staff_capability_key")
  @@index([agencyId, operationalStaffId], map: "operational_staff_capabilities_agency_staff_idx")
  @@map("operational_staff_capabilities")
}

model OperationAssignment {
  id                 String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId           String                  @map("agency_id")
  operationId        String                  @map("operation_id")
  operationalStaffId String                  @map("operational_staff_id")
  role               OperationAssignmentRole
  createdByUserId    String                  @map("created_by_user_id")
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  agency             Agency                  @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "operation_assignments_agency_fk")
  operation          TransportOperation      @relation(fields: [agencyId, operationId], references: [agencyId, id], onDelete: Restrict, map: "operation_assignments_operation_tenant_fk")
  operationalStaff   OperationalStaff        @relation(fields: [agencyId, operationalStaffId], references: [agencyId, id], onDelete: Restrict, map: "operation_assignments_staff_tenant_fk")
  createdByUser      User                    @relation(fields: [agencyId, createdByUserId], references: [agencyId, id], onDelete: Restrict, map: "operation_assignments_created_by_user_tenant_fk")

  @@unique([agencyId, id], map: "operation_assignments_agency_id_key")
  @@unique([agencyId, operationId, role], map: "operation_assignments_operation_role_key")
  @@unique([agencyId, operationId, operationalStaffId, role], map: "operation_assignments_operation_staff_role_key")
  @@index([agencyId, operationId], map: "operation_assignments_agency_operation_idx")
  @@index([agencyId, operationalStaffId], map: "operation_assignments_agency_staff_idx")
  @@map("operation_assignments")
}

// ============================================================
// COMMERCIAL COCKPIT (migration 008_commercial_cockpit.sql)
// Additive only. Does not touch Wish.status / Proposal.status /
// Sale.status -- CommercialOpportunity.stage is its own independent,
// mutable lifecycle for commercial/CRM tracking only.
// ============================================================

model CommercialOpportunity {
  id                 String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId           String          @map("agency_id")
  customerId         String          @map("customer_id")
  wishId             String?         @map("wish_id")
  proposalId         String?         @map("proposal_id")
  saleId             String?         @map("sale_id")
  responsibleUserId  String?         @map("responsible_user_id")
  destination        String?
  tripDateFrom       DateTime?       @map("trip_date_from") @db.Date
  tripDateTo         DateTime?       @map("trip_date_to") @db.Date
  expectedValue      Decimal?        @map("expected_value") @db.Decimal(10, 2)
  // DEPRECATED as of migration 009_configurable_pipelines.sql: kept as a
  // read-only historical artifact (never written to after 008) rather
  // than dropped, to avoid any risk to already-migrated data. The live
  // lifecycle lives in pipelineId/stageId below.
  stage              CommercialStage @default(PROSPECTING)
  pipelineId         String          @map("pipeline_id")
  stageId            String          @map("stage_id")
  nextActionAt       DateTime?       @map("next_action_at") @db.Timestamptz(6)
  lastInteractionAt  DateTime?       @map("last_interaction_at") @db.Timestamptz(6)
  lostReason         String?        @map("lost_reason")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Additive attribution columns (migration 014_offer_growth_foundation.sql,
  // Offer & Growth Engine J/K). Never touches the semantics above.
  sourceChannel      String?         @map("source_channel")
  campaignId         String?         @map("campaign_id")
  publicationId      String?         @map("publication_id")
  offerId            String?         @map("offer_id")
  automationId       String?         @map("automation_id")

  agency          Agency               @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "commercial_opportunities_agency_fk")
  customer        Customer             @relation(fields: [agencyId, customerId], references: [agencyId, id], onDelete: Restrict, map: "commercial_opportunities_customer_tenant_fk")
  wish            Wish?                @relation(fields: [agencyId, wishId], references: [agencyId, id], onDelete: Restrict, map: "commercial_opportunities_wish_tenant_fk")
  proposal        Proposal?            @relation(fields: [agencyId, proposalId], references: [agencyId, id], onDelete: Restrict, map: "commercial_opportunities_proposal_tenant_fk")
  sale            Sale?                @relation(fields: [agencyId, saleId], references: [agencyId, id], onDelete: Restrict, map: "commercial_opportunities_sale_tenant_fk")
  responsibleUser User?                @relation(fields: [agencyId, responsibleUserId], references: [agencyId, id], onDelete: Restrict, map: "commercial_opportunities_responsible_user_tenant_fk")
  pipeline        Pipeline             @relation(fields: [agencyId, pipelineId], references: [agencyId, id], onDelete: Restrict, map: "commercial_opportunities_pipeline_tenant_fk")
  pipelineStage   PipelineStage        @relation(fields: [agencyId, stageId], references: [agencyId, id], onDelete: Restrict, map: "commercial_opportunities_stage_tenant_fk")
  tasks           CommercialTask[]
  interactions    CustomerInteraction[]
  campaign        Campaign?            @relation(fields: [agencyId, campaignId], references: [agencyId, id], onDelete: Restrict, map: "commercial_opportunities_campaign_tenant_fk")
  publication     Publication?         @relation(fields: [agencyId, publicationId], references: [agencyId, id], onDelete: Restrict, map: "commercial_opportunities_publication_tenant_fk")
  offer           Offer?               @relation(fields: [agencyId, offerId], references: [agencyId, id], onDelete: Restrict, map: "commercial_opportunities_offer_tenant_fk")
  automation      Automation?          @relation(fields: [agencyId, automationId], references: [agencyId, id], onDelete: Restrict, map: "commercial_opportunities_automation_tenant_fk")
  engagements     Engagement[]

  @@unique([agencyId, id], map: "commercial_opportunities_agency_id_key")
  @@index([agencyId, stage], map: "commercial_opportunities_agency_stage_idx")
  @@index([agencyId, responsibleUserId], map: "commercial_opportunities_agency_responsible_user_idx")
  @@index([agencyId, nextActionAt], map: "commercial_opportunities_agency_next_action_idx")
  @@index([agencyId, customerId], map: "commercial_opportunities_agency_customer_idx")
  @@index([agencyId, pipelineId], map: "commercial_opportunities_agency_pipeline_idx")
  @@index([agencyId, stageId], map: "commercial_opportunities_agency_stage_id_idx")
  @@index([agencyId, campaignId], map: "commercial_opportunities_agency_campaign_idx")
  @@index([agencyId, publicationId], map: "commercial_opportunities_agency_publication_idx")
  @@map("commercial_opportunities")
}

// Pipeline: an agency-scoped configurable named pipeline (e.g. "Comercial",
// "Pos-venda"). Replaces the old single fixed CommercialStage enum: an
// opportunity now belongs to exactly one Pipeline and one PipelineStage
// within it. See migration 009_configurable_pipelines.sql.
model Pipeline {
  id                   String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId             String                @map("agency_id")
  name                 String
  description          String?
  active               Boolean               @default(true)
  notificationsEnabled Boolean               @default(false) @map("notifications_enabled")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  agency        Agency                  @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "pipelines_agency_fk")
  stages        PipelineStage[]
  opportunities CommercialOpportunity[]
  accesses      PipelineAccess[]

  @@unique([agencyId, id], map: "pipelines_agency_id_key")
  @@index([agencyId], map: "pipelines_agency_idx")
  @@index([agencyId, active], map: "pipelines_agency_active_idx")
  @@map("pipelines")
}

// PipelineStage: an ordered stage within one Pipeline. colorKey is a
// constrained enum (never a free CSS string) that the frontend maps to
// actual CSS classes -- prevents style/CSS injection from admin-entered
// stage config. visualLevel is purely presentational and admin-assigned,
// never inferred from business logic.
model PipelineStage {
  id                   String                    @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId             String                    @map("agency_id")
  pipelineId           String                    @map("pipeline_id")
  name                 String
  sequence             Int
  colorKey           PipelineStageColor        @map("color_key")
  visualLevel          PipelineStageVisualLevel  @default(NORMAL) @map("visual_level")
  active               Boolean                   @default(true)
  notificationsEnabled Boolean                   @default(false) @map("notifications_enabled")
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  agency        Agency                  @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "pipeline_stages_agency_fk")
  pipeline      Pipeline                @relation(fields: [agencyId, pipelineId], references: [agencyId, id], onDelete: Restrict, map: "pipeline_stages_pipeline_tenant_fk")
  opportunities CommercialOpportunity[]

  @@unique([agencyId, id], map: "pipeline_stages_agency_id_key")
  @@index([agencyId, pipelineId, sequence], map: "pipeline_stages_agency_pipeline_sequence_idx")
  @@map("pipeline_stages")
}

// PipelineAccess: smallest-safe-structure join table (deliberately NOT a
// Team/Group model -- no team concept exists anywhere else in this schema)
// granting one userId explicit visibility into one Pipeline. See
// PipelineAccess doc comment in packages/domain/types.ts for the
// default-open-until-restricted enforcement rule.
model PipelineAccess {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId   String   @map("agency_id")
  pipelineId String   @map("pipeline_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  agency   Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "pipeline_access_agency_fk")
  pipeline Pipeline @relation(fields: [agencyId, pipelineId], references: [agencyId, id], onDelete: Restrict, map: "pipeline_access_pipeline_tenant_fk")
  user     User     @relation(fields: [agencyId, userId], references: [agencyId, id], onDelete: Restrict, map: "pipeline_access_user_tenant_fk")

  @@unique([agencyId, pipelineId, userId], map: "pipeline_access_agency_pipeline_user_key")
  @@index([agencyId, userId], map: "pipeline_access_agency_user_idx")
  @@map("pipeline_access")
}

model CommercialTask {
  id              String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId        String             @map("agency_id")
  customerId      String             @map("customer_id")
  opportunityId   String?            @map("opportunity_id")
  assignedUserId  String             @map("assigned_user_id")
  type            CommercialTaskType @default(FOLLOW_UP)
  title           String
  dueAt           DateTime           @map("due_at") @db.Timestamptz(6)
  completedAt     DateTime?          @map("completed_at") @db.Timestamptz(6)
  notes           String?
  createdBy       String             @map("created_by")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  agency       Agency                 @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "commercial_tasks_agency_fk")
  customer     Customer               @relation(fields: [agencyId, customerId], references: [agencyId, id], onDelete: Restrict, map: "commercial_tasks_customer_tenant_fk")
  opportunity  CommercialOpportunity? @relation(fields: [agencyId, opportunityId], references: [agencyId, id], onDelete: Restrict, map: "commercial_tasks_opportunity_tenant_fk")
  assignedUser User                   @relation("CommercialTaskAssignedUser", fields: [agencyId, assignedUserId], references: [agencyId, id], onDelete: Restrict, map: "commercial_tasks_assigned_user_tenant_fk")
  creator      User                   @relation("CommercialTaskCreatedBy", fields: [agencyId, createdBy], references: [agencyId, id], onDelete: Restrict, map: "commercial_tasks_created_by_tenant_fk")

  @@unique([agencyId, id], map: "commercial_tasks_agency_id_key")
  @@index([agencyId, dueAt], map: "commercial_tasks_agency_due_at_idx")
  @@index([agencyId, assignedUserId], map: "commercial_tasks_agency_assigned_user_idx")
  @@index([agencyId, customerId], map: "commercial_tasks_agency_customer_idx")
  @@map("commercial_tasks")
}

model CustomerInteraction {
  id             String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId       String                @map("agency_id")
  customerId     String                @map("customer_id")
  opportunityId  String?               @map("opportunity_id")
  proposalId     String?               @map("proposal_id")
  saleId         String?               @map("sale_id")
  userId         String                @map("user_id")
  channel        InteractionChannel
  direction      InteractionDirection
  occurredAt     DateTime              @default(now()) @map("occurred_at") @db.Timestamptz(6)
  summary        String
  nextActionAt   DateTime?             @map("next_action_at") @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  agency      Agency                 @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "customer_interactions_agency_fk")
  customer    Customer               @relation(fields: [agencyId, customerId], references: [agencyId, id], onDelete: Restrict, map: "customer_interactions_customer_tenant_fk")
  opportunity CommercialOpportunity? @relation(fields: [agencyId, opportunityId], references: [agencyId, id], onDelete: Restrict, map: "customer_interactions_opportunity_tenant_fk")
  proposal    Proposal?              @relation(fields: [agencyId, proposalId], references: [agencyId, id], onDelete: Restrict, map: "customer_interactions_proposal_tenant_fk")
  sale        Sale?                  @relation(fields: [agencyId, saleId], references: [agencyId, id], onDelete: Restrict, map: "customer_interactions_sale_tenant_fk")
  user        User                   @relation(fields: [agencyId, userId], references: [agencyId, id], onDelete: Restrict, map: "customer_interactions_user_tenant_fk")

  @@unique([agencyId, id], map: "customer_interactions_agency_id_key")
  @@index([agencyId, customerId], map: "customer_interactions_agency_customer_idx")
  @@index([agencyId, occurredAt], map: "customer_interactions_agency_occurred_at_idx")
  @@map("customer_interactions")
}

// ============================================================
// OFFER & GROWTH ENGINE (migration 014_offer_growth_foundation.sql)
// See docs/adr/ADR-OFFER-GROWTH-001 and docs/offer-growth/*.md.
// ============================================================

model Asset {
  id                      String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId                String          @map("agency_id")
  type                    AssetType
  source                  AssetSourceType
  sourceConnector         String?         @map("source_connector")
  sourceSupplier          String?         @map("source_supplier")
  sourceOriginalUrl       String?         @map("source_original_url")
  sourceLicense           String?         @map("source_license")
  sourceAuthor            String?         @map("source_author")
  sourceDedupeHash        String?         @map("source_dedupe_hash")
  sourceUsageRestrictions String?         @map("source_usage_restrictions")
  sourceCaptureId         String?         @map("source_capture_id")
  metaWidth               Int?            @map("meta_width")
  metaHeight              Int?            @map("meta_height")
  metaDurationSeconds     Decimal?        @map("meta_duration_seconds") @db.Decimal(10, 2)
  metaMimeType            String?         @map("meta_mime_type")
  metaSizeBytes           BigInt?         @map("meta_size_bytes")
  metaLanguage            String?         @map("meta_language")
  metaTags                Json            @default("[]") @map("meta_tags")
  metaSafeArea            Json?           @map("meta_safe_area")
  metaVariants            Json            @default("[]") @map("meta_variants")
  storageUrl              String?         @map("storage_url")
  localReference          String?         @map("local_reference")
  createdByUserId         String?         @map("created_by_user_id")
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  agency         Agency                @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "assets_agency_fk")
  createdByUser  User?                 @relation(fields: [agencyId, createdByUserId], references: [agencyId, id], onDelete: Restrict, map: "assets_created_by_user_tenant_fk")
  sourceCapture  ExternalOfferCapture? @relation(fields: [agencyId, sourceCaptureId], references: [agencyId, id], onDelete: Restrict, map: "assets_source_capture_tenant_fk")

  @@unique([agencyId, id], map: "assets_agency_id_key")
  @@index([agencyId, type], map: "assets_agency_type_idx")
  @@index([agencyId, source], map: "assets_agency_source_idx")
  @@index([agencyId, sourceDedupeHash], map: "assets_agency_dedupe_hash_idx")
  @@index([agencyId, sourceCaptureId], map: "assets_agency_capture_idx")
  @@map("assets")
}

model Campaign {
  id                   String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId             String         @map("agency_id")
  name                 String
  description          String?
  startsAt             DateTime?      @map("starts_at") @db.Timestamptz(6)
  endsAt               DateTime?      @map("ends_at") @db.Timestamptz(6)
  publicationStartsAt  DateTime?      @map("publication_starts_at") @db.Timestamptz(6)
  publicationEndsAt    DateTime?      @map("publication_ends_at") @db.Timestamptz(6)
  timezone             String         @default("UTC")
  status               CampaignStatus @default(DRAFT)
  createdByUserId      String?        @map("created_by_user_id")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  agency          Agency           @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "campaigns_agency_fk")
  createdByUser   User?            @relation(fields: [agencyId, createdByUserId], references: [agencyId, id], onDelete: Restrict, map: "campaigns_created_by_user_tenant_fk")
  campaignOffers  CampaignOffer[]
  publications    Publication[]
  automations     Automation[]
  coupons         Coupon[]
  couponGrants    CouponGrant[]
  engagements     Engagement[]
  opportunities   CommercialOpportunity[]

  @@unique([agencyId, id], map: "campaigns_agency_id_key")
  @@index([agencyId, status], map: "campaigns_agency_status_idx")
  @@map("campaigns")
}

model CampaignOffer {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId   String   @map("agency_id")
  campaignId String   @map("campaign_id")
  offerId    String   @map("offer_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  agency   Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "campaign_offers_agency_fk")
  campaign Campaign @relation(fields: [agencyId, campaignId], references: [agencyId, id], onDelete: Restrict, map: "campaign_offers_campaign_tenant_fk")
  offer    Offer    @relation(fields: [agencyId, offerId], references: [agencyId, id], onDelete: Restrict, map: "campaign_offers_offer_tenant_fk")

  @@unique([agencyId, id], map: "campaign_offers_agency_id_key")
  @@unique([agencyId, campaignId, offerId], map: "campaign_offers_unique")
  @@index([agencyId, campaignId], map: "campaign_offers_agency_campaign_idx")
  @@index([agencyId, offerId], map: "campaign_offers_agency_offer_idx")
  @@map("campaign_offers")
}

model Publication {
  id                     String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId               String            @map("agency_id")
  campaignId             String            @map("campaign_id")
  offerId                String            @map("offer_id")
  creativeTemplateId     String?           @map("creative_template_id")
  channel                String
  snapshot               Json?
  snapshotGeneratedAt    DateTime?         @map("snapshot_generated_at") @db.Timestamptz(6)
  scheduledAt            DateTime?         @map("scheduled_at") @db.Timestamptz(6)
  publishedAt            DateTime?         @map("published_at") @db.Timestamptz(6)
  status                 PublicationStatus @default(DRAFT)
  externalPublicationId  String?           @map("external_publication_id")
  createdByUserId        String?           @map("created_by_user_id")
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  agency          Agency                  @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "publications_agency_fk")
  campaign        Campaign                @relation(fields: [agencyId, campaignId], references: [agencyId, id], onDelete: Restrict, map: "publications_campaign_tenant_fk")
  offer           Offer                   @relation(fields: [agencyId, offerId], references: [agencyId, id], onDelete: Restrict, map: "publications_offer_tenant_fk")
  createdByUser   User?                   @relation(fields: [agencyId, createdByUserId], references: [agencyId, id], onDelete: Restrict, map: "publications_created_by_user_tenant_fk")
  automations     Automation[]
  engagements     Engagement[]
  couponGrants    CouponGrant[]
  connectorActions ConnectorAction[]
  opportunities   CommercialOpportunity[]

  @@unique([agencyId, id], map: "publications_agency_id_key")
  @@index([agencyId, status], map: "publications_agency_status_idx")
  @@index([agencyId, campaignId], map: "publications_agency_campaign_idx")
  @@index([agencyId, offerId], map: "publications_agency_offer_idx")
  @@index([agencyId, channel], map: "publications_agency_channel_idx")
  @@map("publications")
}

model AgencyEntitlement {
  id        String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId  String          @map("agency_id")
  feature   PlatformFeature
  enabled   Boolean         @default(false)
  limits    Json            @default("{}")
  updatedBy String          @map("updated_by")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "agency_entitlements_agency_fk")

  @@unique([agencyId, id], map: "agency_entitlements_agency_id_key")
  @@unique([agencyId, feature], map: "agency_entitlements_unique")
