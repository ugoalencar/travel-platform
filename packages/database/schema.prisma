model CouponRedemption {
  id                 String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId           String    @map("agency_id")
  couponId           String    @map("coupon_id")
  grantId            String?   @map("grant_id")
  customerId         String    @map("customer_id")
  proposalId         String?   @map("proposal_id")
  saleId             String?   @map("sale_id")
  amountApplied      Decimal?  @map("amount_applied") @db.Decimal(10, 2)
  redeemedAt         DateTime  @default(now()) @map("redeemed_at") @db.Timestamptz(6)
  reversedAt         DateTime? @map("reversed_at") @db.Timestamptz(6)
  recordedByUserId   String?   @map("recorded_by_user_id")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  agency         Agency       @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "coupon_redemptions_agency_fk")
  coupon         Coupon       @relation(fields: [agencyId, couponId], references: [agencyId, id], onDelete: Restrict, map: "coupon_redemptions_coupon_tenant_fk")
  grant          CouponGrant? @relation(fields: [agencyId, grantId], references: [agencyId, id], onDelete: Restrict, map: "coupon_redemptions_grant_tenant_fk")
  customer       Customer     @relation(fields: [agencyId, customerId], references: [agencyId, id], onDelete: Restrict, map: "coupon_redemptions_customer_tenant_fk")
  proposal       Proposal?    @relation(fields: [agencyId, proposalId], references: [agencyId, id], onDelete: Restrict, map: "coupon_redemptions_proposal_tenant_fk")
  sale           Sale?        @relation(fields: [agencyId, saleId], references: [agencyId, id], onDelete: Restrict, map: "coupon_redemptions_sale_tenant_fk")
  recordedByUser User?        @relation(fields: [agencyId, recordedByUserId], references: [agencyId, id], onDelete: Restrict, map: "coupon_redemptions_recorded_by_user_tenant_fk")

  @@unique([agencyId, id], map: "coupon_redemptions_agency_id_key")
  @@index([agencyId, couponId], map: "coupon_redemptions_agency_coupon_idx")
  @@index([agencyId, customerId], map: "coupon_redemptions_agency_customer_idx")
  @@map("coupon_redemptions")
}

