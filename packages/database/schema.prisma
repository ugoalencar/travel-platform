model Automation {
  id                             String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId                       String            @map("agency_id")
  name                           String
  trigger                        AutomationTrigger
  status                         AutomationStatus  @default(DRAFT)
  channel                        String?
  campaignId                     String?           @map("campaign_id")
  publicationId                  String?           @map("publication_id")
  keyword                        String?
  caseSensitive                  Boolean           @default(false) @map("case_sensitive")
  actions                        Json              @default("[]")
  validFrom                      DateTime?         @map("valid_from") @db.Timestamptz(6)
  validUntil                     DateTime?         @map("valid_until") @db.Timestamptz(6)
  cooldownSeconds                Int               @default(0) @map("cooldown_seconds")
  maxExecutions                  Int?              @map("max_executions")
  maxExecutionsPerExternalUser   Int?              @map("max_executions_per_external_user")
  createdByUserId                String?           @map("created_by_user_id")
  createdAt                      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  agency        Agency                @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "automations_agency_fk")
  campaign      Campaign?             @relation(fields: [agencyId, campaignId], references: [agencyId, id], onDelete: Restrict, map: "automations_campaign_tenant_fk")
  publication   Publication?          @relation(fields: [agencyId, publicationId], references: [agencyId, id], onDelete: Restrict, map: "automations_publication_tenant_fk")
  createdByUser User?                 @relation(fields: [agencyId, createdByUserId], references: [agencyId, id], onDelete: Restrict, map: "automations_created_by_user_tenant_fk")
  executions       AutomationExecution[]
  couponGrants     CouponGrant[]
  connectorActions ConnectorAction[]
  opportunities    CommercialOpportunity[]

  @@unique([agencyId, id], map: "automations_agency_id_key")
  @@index([agencyId, status], map: "automations_agency_status_idx")
  @@index([agencyId, campaignId], map: "automations_agency_campaign_idx")
  @@index([agencyId, trigger], map: "automations_agency_trigger_idx")
  @@map("automations")
}

model AutomationExecution {
  id                String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId          String     @map("agency_id")
  automationId      String     @map("automation_id")
  engagementId      String?    @map("engagement_id")
  channel           String
  externalUserId    String     @default("__none__") @map("external_user_id")
  normalizedKeyword String     @default("__none__") @map("normalized_keyword")
  publicationId     String     @default("__none__") @map("publication_id")
  executedAt        DateTime   @default(now()) @map("executed_at") @db.Timestamptz(6)
  result            Json?

  agency     Agency      @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "automation_executions_agency_fk")
  automation Automation  @relation(fields: [agencyId, automationId], references: [agencyId, id], onDelete: Restrict, map: "automation_executions_automation_tenant_fk")
  engagement Engagement? @relation(fields: [agencyId, engagementId], references: [agencyId, id], onDelete: Restrict, map: "automation_executions_engagement_tenant_fk")

  @@unique([agencyId, id], map: "automation_executions_agency_id_key")
  @@unique([agencyId, automationId, channel, externalUserId, normalizedKeyword, publicationId], map: "automation_executions_dedup_key")
  @@index([agencyId, automationId], map: "automation_executions_agency_automation_idx")
  @@index([agencyId, externalUserId], map: "automation_executions_agency_external_user_idx")
  @@map("automation_executions")
}

model Coupon {
  id                  String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId            String     @map("agency_id")
  code                String
  name                String
  type                CouponType
  value               Decimal?   @db.Decimal(10, 2)
  benefitDescription  String?    @map("benefit_description")
  startsAt            DateTime?  @map("starts_at") @db.Timestamptz(6)
  expiresAt           DateTime?  @map("expires_at") @db.Timestamptz(6)
  maxUses             Int?       @map("max_uses")
  maxUsesPerCustomer  Int?       @map("max_uses_per_customer")
  campaignId          String?    @map("campaign_id")
  offerId             String?    @map("offer_id")
  active              Boolean    @default(true)
  createdByUserId     String?    @map("created_by_user_id")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  agency        Agency        @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "coupons_agency_fk")
  campaign      Campaign?     @relation(fields: [agencyId, campaignId], references: [agencyId, id], onDelete: Restrict, map: "coupons_campaign_tenant_fk")
  offer         Offer?        @relation(fields: [agencyId, offerId], references: [agencyId, id], onDelete: Restrict, map: "coupons_offer_tenant_fk")
  createdByUser User?         @relation(fields: [agencyId, createdByUserId], references: [agencyId, id], onDelete: Restrict, map: "coupons_created_by_user_tenant_fk")
  grants        CouponGrant[]
  redemptions   CouponRedemption[]

  @@unique([agencyId, id], map: "coupons_agency_id_key")
  @@unique([agencyId, code], map: "coupons_agency_code_key")
  @@index([agencyId, active], map: "coupons_agency_active_idx")
  @@index([agencyId, campaignId], map: "coupons_agency_campaign_idx")
  @@map("coupons")
}

model CouponGrant {
  id               String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId         String            @map("agency_id")
  couponId         String            @map("coupon_id")
  campaignId       String?           @map("campaign_id")
