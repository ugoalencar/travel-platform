generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// MULTI-TENANT: Agency = Tenant
// REGRA: USER -> AGENCY -> RESOURCE
// Nunca: USER -> RESOURCE
// ============================================================
//
// SOURCE OF TRUTH: infrastructure/migrations/*.sql (ADR-005).
// This file is a DERIVED representation, produced by `prisma db pull`
// against a database with the ordered SQL migrations applied, then hand-annotated only where
// introspection cannot express something the SQL already guarantees
// (see the onDelete note below). Do not hand-edit structural fields,
// types, relations, or `@map`/`@@map` values here without first
// changing the SQL and re-running introspection -- that is how this
// file drifts out of sync with what PostgreSQL actually enforces.
//
// NOT representable in this file at all (SQL only):
//   - Row-Level Security (ENABLE/FORCE RLS, CREATE POLICY)
//   - current_agency_id() / current_user_id() / set_tenant_context() /
//     clear_tenant_context()
//   - CHECK constraints (non-negative amounts, date ranges, state guards, etc.)
//   - Partial unique indexes (customers_agency_cpf_active_key,
//     customers_agency_email_active_key -- WHERE ... AND deleted_at IS NULL)
//   - Runtime role grants (travel_app_runtime_local, no BYPASSRLS)
// ============================================================

model Agency {
  id                   String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  name                 String
  slug                 String                @unique
  cnpj                 String?               @unique
  email                String?
  phone                String?
  address              Json?
  settings             Json?
  plan                 Plan                  @default(FREE)
  status               Status                @default(ACTIVE)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookingPassengers    BookingPassenger[]
  bookings             Booking[]
  brokers              Broker[]
  commissions          Commission[]
  receivables          Receivable[]
  payables             Payable[]
  payments             Payment[]
  paymentAllocations   PaymentAllocation[]
  operationalCosts     OperationalCost[]
  customerAccounts     CustomerAccount[]
  customers            Customer[]
  addresses            CustomerAddress[]
  offers               Offer[]
  proposals            Proposal[]
  sales                Sale[]
  trips                Trip[]
  users                User[]
  wishes               Wish[]
  routes               Route[]
  routePoints          RoutePoint[]
  operationalStaff     OperationalStaff[]
  operationalStaffCapabilities OperationalStaffCapabilityEntry[]
  operationAssignments OperationAssignment[]
  suppliers            Supplier[]
  transportProducts    TransportProduct[]
  scheduledDepartures  ScheduledDeparture[]
  transportOperations  TransportOperation[]
  operationCheckpoints OperationCheckpoint[]
  commercialOpportunities CommercialOpportunity[]
  commercialTasks         CommercialTask[]
  customerInteractions    CustomerInteraction[]
  pipelines               Pipeline[]
  pipelineStages          PipelineStage[]
  pipelineAccesses        PipelineAccess[]
  externalOfferCaptures   ExternalOfferCapture[]
  assets                  Asset[]
  campaigns               Campaign[]
  campaignOffers          CampaignOffer[]
  publications            Publication[]
  agencyEntitlements      AgencyEntitlement[]
  engagements             Engagement[]
  automations             Automation[]
  automationExecutions    AutomationExecution[]
  coupons                 Coupon[]
  couponGrants            CouponGrant[]
  couponRedemptions       CouponRedemption[]
  connectorActions        ConnectorAction[]
  offerGrowthAuditLog     OfferGrowthAuditLog[]

  @@map("agencies")
}

model User {
  id           String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId     String       @map("agency_id")
  email        String
  name         String
  role         UserRole
  passwordHash String       @map("password_hash")
  status       Status       @default(ACTIVE)
  lastLoginAt  DateTime?    @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  commissions  Commission[]
  payments     Payment[]
  operationalCosts OperationalCost[]
  proposals    Proposal[]
  sales        Sale[]
  agency       Agency       @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "users_agency_fk")
  commercialOpportunities CommercialOpportunity[]
  commercialTasksAssigned CommercialTask[]         @relation("CommercialTaskAssignedUser")
  commercialTasksCreated  CommercialTask[]         @relation("CommercialTaskCreatedBy")
  customerInteractions    CustomerInteraction[]
  cancelledBookings       Booking[]                @relation("BookingCancelledByUser")
  operationalStaffProfiles OperationalStaff[]
  operationAssignmentsCreated OperationAssignment[]
  arrivalConfirmations     OperationCheckpoint[]    @relation("OperationCheckpointArrivalConfirmedBy")
  departureConfirmations   OperationCheckpoint[]    @relation("OperationCheckpointDepartureConfirmedBy")
  pipelineAccesses        PipelineAccess[]
  reviewedExternalOfferCaptures ExternalOfferCapture[]
  createdAssets           Asset[]
  createdCampaigns        Campaign[]
  createdPublications     Publication[]
  createdAutomations      Automation[]
  createdCoupons          Coupon[]
  recordedCouponRedemptions CouponRedemption[]
  offerGrowthAuditLogEntries OfferGrowthAuditLog[]

  @@unique([agencyId, email], map: "users_agency_email_key")
  @@unique([agencyId, id], map: "users_agency_id_key")
  @@index([agencyId], map: "users_agency_idx")
  @@map("users")
}

model Broker {
  id          String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId    String       @map("agency_id")
  name        String
  email       String
  phone       String?
  commission  Decimal      @default(0) @db.Decimal(5, 2)
  status      Status       @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "brokers_agency_fk")
  commissions Commission[]
  sales       Sale[]

  @@unique([agencyId, email], map: "brokers_agency_email_key")
  @@unique([agencyId, id], map: "brokers_agency_id_key")
  @@index([agencyId], map: "brokers_agency_idx")
  @@map("brokers")
}

model Customer {
  id        String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId  String           @map("agency_id")
  name      String
  email     String?
  phone     String?
  cpf       String?
  passport  String?
  rg        String?
  nationalIdType String? @map("national_id_type")
  birthDate DateTime?        @map("birth_date") @db.Date
  nationality String?
  whatsapp  String?
  address   Json?
  notes     String?
  status    Status           @default(ACTIVE)
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  account   CustomerAccount?
  agency    Agency           @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "customers_agency_fk")
  addresses CustomerAddress[] @relation("CustomerAddresses")
  bookings  Booking[]
  receivables Receivable[]
  proposals Proposal[]
  sales     Sale[]
  trips     Trip[]
  wishes    Wish[]
  commercialOpportunities CommercialOpportunity[]
  commercialTasks         CommercialTask[]
  customerInteractions    CustomerInteraction[]
  engagements             Engagement[]
  couponGrants            CouponGrant[]
  couponRedemptions       CouponRedemption[]

  // Migration 001 also enforces active-customer uniqueness with partial
  // indexes not representable here:
  // (agency_id, cpf) WHERE cpf IS NOT NULL AND deleted_at IS NULL
  // (agency_id, email) WHERE email IS NOT NULL AND deleted_at IS NULL
  @@unique([agencyId, id], map: "customers_agency_id_key")
  @@index([agencyId, cpf], map: "customers_agency_cpf_idx")
  @@index([agencyId, email], map: "customers_agency_email_idx")
  @@index([agencyId], map: "customers_agency_idx")
  @@index([agencyId, name], map: "customers_agency_name_idx")
  @@map("customers")
}

model CustomerAccount {
  id           String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId     String                @map("agency_id")
  customerId   String                @map("customer_id")
  email        String
  passwordHash String                @map("password_hash")
  status       CustomerAccountStatus @default(ACTIVE)
  lastLoginAt  DateTime?             @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  agency       Agency                @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "customer_accounts_agency_fk")
  customer     Customer              @relation(fields: [agencyId, customerId], references: [agencyId, id], onDelete: Restrict, map: "customer_accounts_customer_tenant_fk")

  @@unique([agencyId, customerId], map: "customer_accounts_agency_customer_key")
  @@unique([agencyId, email], map: "customer_accounts_agency_email_key")
  @@index([agencyId], map: "customer_accounts_agency_idx")
  @@map("customer_accounts")
}

model Wish {
  id             String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId       String     @map("agency_id")
  customerId     String     @map("customer_id")
  destination    String?
  startDate      DateTime?  @map("start_date") @db.Date
  endDate        DateTime?  @map("end_date") @db.Date
  budget         Decimal?   @db.Decimal(10, 2)
  travelersCount Int?       @map("travelers_count")
  notes          String?
  status         WishStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  proposals      Proposal[]
  agency         Agency     @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "wishes_agency_fk")
  customer       Customer   @relation(fields: [agencyId, customerId], references: [agencyId, id], onDelete: Restrict, map: "wishes_customer_tenant_fk")
  commercialOpportunities CommercialOpportunity[]

  @@unique([agencyId, id], map: "wishes_agency_id_key")
  @@index([agencyId, customerId], map: "wishes_agency_customer_idx")
  @@index([agencyId], map: "wishes_agency_idx")
  @@index([agencyId, startDate], map: "wishes_agency_start_date_idx")
  @@index([agencyId, status], map: "wishes_agency_status_idx")
  @@map("wishes")
}

model Offer {
  id          String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId    String      @map("agency_id")
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  validFrom   DateTime?   @map("valid_from") @db.Timestamptz(6)
  validUntil  DateTime?   @map("valid_until") @db.Timestamptz(6)
  status      OfferStatus @default(ACTIVE)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  agency      Agency      @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "offers_agency_fk")
  proposals   Proposal[]
  externalCaptures ExternalOfferCapture[]
  campaignOffers   CampaignOffer[]
  publications     Publication[]
  engagements      Engagement[]
  coupons          Coupon[]
  commercialOpportunities CommercialOpportunity[]

  @@unique([agencyId, id], map: "offers_agency_id_key")
  @@index([agencyId], map: "offers_agency_idx")
  @@index([agencyId, status], map: "offers_agency_status_idx")
  @@index([agencyId, validUntil], map: "offers_agency_valid_until_idx")
  @@map("offers")
}

model ExternalOfferCapture {
  id                    String                     @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId              String                     @map("agency_id")
  sourceUrl             String                     @map("source_url")
  sourceName            String                     @map("source_name")
  capturedAt            DateTime                   @default(now()) @map("captured_at") @db.Timestamptz(6)
  rawContent            String                     @map("raw_content")
  normalizedTitle       String?                    @map("normalized_title")
  normalizedDescription String?                    @map("normalized_description")
  foundPrice            Decimal?                   @map("found_price") @db.Decimal(10, 2)
  currency              String?
  validUntil            DateTime?                  @map("valid_until") @db.Timestamptz(6)
  status                ExternalOfferCaptureStatus @default(CAPTURED)
  reviewedAt            DateTime?                  @map("reviewed_at") @db.Timestamptz(6)
  reviewedByUserId      String?                    @map("reviewed_by_user_id")
  publishedOfferId      String?                    @map("published_offer_id")
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  agency                Agency                     @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "external_offer_captures_agency_fk")
  reviewedByUser        User?                      @relation(fields: [agencyId, reviewedByUserId], references: [agencyId, id], onDelete: Restrict, map: "external_offer_captures_reviewed_by_user_tenant_fk")
  publishedOffer        Offer?                     @relation(fields: [agencyId, publishedOfferId], references: [agencyId, id], onDelete: Restrict, map: "external_offer_captures_published_offer_tenant_fk")
  assets                Asset[]

  @@unique([agencyId, id], map: "external_offer_captures_agency_id_key")
  @@unique([agencyId, sourceUrl], map: "external_offer_captures_agency_source_url_key")
  @@index([agencyId, status, createdAt], map: "external_offer_captures_agency_status_idx")
  @@index([agencyId, reviewedByUserId], map: "external_offer_captures_agency_reviewed_by_idx")
  @@index([agencyId, publishedOfferId], map: "external_offer_captures_agency_published_offer_idx")
  @@map("external_offer_captures")
}

model Proposal {
  id            String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId      String         @map("agency_id")
  customerId    String         @map("customer_id")
  offerId       String?        @map("offer_id")
  wishId        String?        @map("wish_id")
  userId        String?        @map("user_id")
  proposedPrice Decimal        @map("proposed_price") @db.Decimal(10, 2)
  discount      Decimal        @default(0) @db.Decimal(10, 2)
  total         Decimal        @db.Decimal(10, 2)
  validUntil    DateTime?      @map("valid_until") @db.Timestamptz(6)
  conditions    String?
  notes         String?
  status        ProposalStatus @default(DRAFT)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  agency        Agency         @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "proposals_agency_fk")
  customer      Customer       @relation(fields: [agencyId, customerId], references: [agencyId, id], onDelete: Restrict, map: "proposals_customer_tenant_fk")
  // offerId/wishId/userId are nullable columns: Prisma's implicit
  // onDelete default for an OPTIONAL relation is SetNull, not Restrict
  // (verified empirically -- see ADR-005). The database enforces
  // RESTRICT on all three regardless of what this file says, but
  // leaving onDelete implicit here would make this file claim
  // behavior PostgreSQL does not actually have. Explicit and required
  // for this file to be accurate, not just for readability.
  offer         Offer?         @relation(fields: [agencyId, offerId], references: [agencyId, id], onDelete: Restrict, map: "proposals_offer_tenant_fk")
  user          User?          @relation(fields: [agencyId, userId], references: [agencyId, id], onDelete: Restrict, map: "proposals_user_tenant_fk")
  wish          Wish?          @relation(fields: [agencyId, wishId], references: [agencyId, id], onDelete: Restrict, map: "proposals_wish_tenant_fk")
  sale          Sale?
  commercialOpportunities CommercialOpportunity[]
  customerInteractions    CustomerInteraction[]
  couponRedemptions       CouponRedemption[]

  @@unique([agencyId, id], map: "proposals_agency_id_key")
  @@index([agencyId, customerId], map: "proposals_agency_customer_idx")
  @@index([agencyId], map: "proposals_agency_idx")
  @@index([agencyId, status], map: "proposals_agency_status_idx")
  @@index([agencyId, validUntil], map: "proposals_agency_valid_until_idx")
  @@map("proposals")
}

model Sale {
  id          String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId    String       @map("agency_id")
  customerId  String       @map("customer_id")
  proposalId  String?      @map("proposal_id")
  brokerId    String?      @map("broker_id")
  userId      String       @map("user_id")
  amount      Decimal      @db.Decimal(10, 2)
  discount    Decimal      @default(0) @db.Decimal(10, 2)
  total       Decimal      @db.Decimal(10, 2)
  status      SaleStatus   @default(PENDING)
  notes       String?
  paidAt      DateTime?    @map("paid_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  commissions Commission[]
  receivables Receivable[]
  payables    Payable[]
  operationalCosts OperationalCost[]
  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "sales_agency_fk")
  // proposalId/brokerId are nullable: same SetNull-by-default risk as
  // Proposal.offer/wish/user above. Explicit onDelete: Restrict here
  // is required for accuracy, not decorative.
  broker      Broker?      @relation(fields: [agencyId, brokerId], references: [agencyId, id], onDelete: Restrict, map: "sales_broker_tenant_fk")
  customer    Customer     @relation(fields: [agencyId, customerId], references: [agencyId, id], onDelete: Restrict, map: "sales_customer_tenant_fk")
  proposal    Proposal?    @relation(fields: [agencyId, proposalId], references: [agencyId, id], onDelete: Restrict, map: "sales_proposal_tenant_fk")
  user        User         @relation(fields: [agencyId, userId], references: [agencyId, id], onDelete: Restrict, map: "sales_user_tenant_fk")
  trip        Trip?
  commercialOpportunities CommercialOpportunity[]
  customerInteractions    CustomerInteraction[]
  couponRedemptions       CouponRedemption[]

  @@unique([agencyId, id], map: "sales_agency_id_key")
  @@unique([agencyId, proposalId], map: "sales_agency_proposal_key")
  @@index([agencyId, createdAt], map: "sales_agency_created_at_idx")
  @@index([agencyId, customerId], map: "sales_agency_customer_idx")
  @@index([agencyId], map: "sales_agency_idx")
  @@index([agencyId, status], map: "sales_agency_status_idx")
  @@map("sales")
}

model Commission {
  id         String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId   String           @map("agency_id")
  saleId     String           @map("sale_id")
  brokerId   String?          @map("broker_id")
  userId     String?          @map("user_id")
  amount     Decimal          @db.Decimal(10, 2)
  percentage Decimal?         @db.Decimal(5, 2)
  status     CommissionStatus @default(PENDING)
  paidAt     DateTime?        @map("paid_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  agency     Agency           @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "commissions_agency_fk")
  // brokerId/userId are nullable: same SetNull-by-default risk noted
  // above. Explicit onDelete: Restrict here is required for accuracy.
  broker     Broker?          @relation(fields: [agencyId, brokerId], references: [agencyId, id], onDelete: Restrict, map: "commissions_broker_tenant_fk")
  sale       Sale             @relation(fields: [agencyId, saleId], references: [agencyId, id], onDelete: Restrict, map: "commissions_sale_tenant_fk")
  user       User?            @relation(fields: [agencyId, userId], references: [agencyId, id], onDelete: Restrict, map: "commissions_user_tenant_fk")
  payables   Payable[]

  // Repaired by 007_commission_repair.sql (D1, Option A): commissions
  // now has UNIQUE(agency_id, id), matching every other tenant-scoped
  // table in this schema, so future tables can reference it via a
  // composite tenant-safe FK.
  @@unique([agencyId, id], map: "commissions_agency_id_key")
  @@index([agencyId], map: "commissions_agency_idx")
  @@index([agencyId, saleId], map: "commissions_agency_sale_idx")
  @@index([agencyId, status], map: "commissions_agency_status_idx")
  @@map("commissions")
}

model Receivable {
  id          String                    @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId    String                    @map("agency_id")
  saleId      String?                   @map("sale_id")
  customerId  String                    @map("customer_id")
  description String
  amount      Decimal                   @db.Decimal(12, 2)
  dueAt       DateTime                  @map("due_at") @db.Timestamptz(6)
  status      FinancialObligationStatus @default(OPEN)
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  agency   Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "receivables_agency_fk")
  sale     Sale?    @relation(fields: [agencyId, saleId], references: [agencyId, id], onDelete: Restrict, map: "receivables_sale_tenant_fk")
  customer Customer @relation(fields: [agencyId, customerId], references: [agencyId, id], onDelete: Restrict, map: "receivables_customer_tenant_fk")
  allocations PaymentAllocation[]

  @@unique([agencyId, id], map: "receivables_agency_id_key")
  @@unique([agencyId, saleId], map: "receivables_agency_sale_key")
  @@index([agencyId, status, dueAt], map: "receivables_agency_status_due_idx")
  @@index([agencyId, customerId], map: "receivables_agency_customer_idx")
  @@map("receivables")
}

model Payable {
  id                   String                    @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId             String                    @map("agency_id")
  saleId               String?                   @map("sale_id")
  supplierId           String?                   @map("supplier_id")
  commissionId         String?                   @map("commission_id")
  transportOperationId String?                   @map("transport_operation_id")
  operationalCostId    String?                   @map("operational_cost_id")
  description          String
  amount               Decimal                   @db.Decimal(12, 2)
  dueAt                DateTime                  @map("due_at") @db.Timestamptz(6)
  status               FinancialObligationStatus @default(OPEN)
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  agency             Agency              @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "payables_agency_fk")
  sale               Sale?               @relation(fields: [agencyId, saleId], references: [agencyId, id], onDelete: Restrict, map: "payables_sale_tenant_fk")
  supplier           Supplier?           @relation(fields: [agencyId, supplierId], references: [agencyId, id], onDelete: Restrict, map: "payables_supplier_tenant_fk")
  commission         Commission?         @relation(fields: [agencyId, commissionId], references: [agencyId, id], onDelete: Restrict, map: "payables_commission_tenant_fk")
  transportOperation TransportOperation? @relation(fields: [agencyId, transportOperationId], references: [agencyId, id], onDelete: Restrict, map: "payables_operation_tenant_fk")
  operationalCost    OperationalCost?    @relation(fields: [agencyId, operationalCostId], references: [agencyId, id], onDelete: Restrict, map: "payables_operational_cost_tenant_fk")
  allocations        PaymentAllocation[]

  @@unique([agencyId, id], map: "payables_agency_id_key")
  @@index([agencyId, status, dueAt], map: "payables_agency_status_due_idx")
  @@index([agencyId, supplierId], map: "payables_agency_supplier_idx")
  @@index([agencyId, saleId], map: "payables_agency_sale_idx")
  @@index([agencyId, transportOperationId], map: "payables_agency_operation_idx")
  @@map("payables")
}

model Payment {
  id          String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId    String           @map("agency_id")
  direction   PaymentDirection
  amount      Decimal          @db.Decimal(12, 2)
  occurredAt  DateTime         @map("occurred_at") @db.Timestamptz(6)
  method      String?
  reference   String?
  notes       String?
  createdBy   String           @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  agency      Agency              @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "payments_agency_fk")
  creator     User                @relation(fields: [agencyId, createdBy], references: [agencyId, id], onDelete: Restrict, map: "payments_created_by_tenant_fk")
  allocations PaymentAllocation[]

  @@unique([agencyId, id], map: "payments_agency_id_key")
  @@index([agencyId, direction, occurredAt], map: "payments_agency_direction_occurred_idx")
  @@map("payments")
}

model PaymentAllocation {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId     String   @map("agency_id")
  paymentId    String   @map("payment_id")
  receivableId String?  @map("receivable_id")
  payableId    String?  @map("payable_id")
  amount       Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  agency     Agency      @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "payment_allocations_agency_fk")
  payment    Payment     @relation(fields: [agencyId, paymentId], references: [agencyId, id], onDelete: Restrict, map: "payment_allocations_payment_tenant_fk")
  receivable Receivable? @relation(fields: [agencyId, receivableId], references: [agencyId, id], onDelete: Restrict, map: "payment_allocations_receivable_tenant_fk")
  payable    Payable?    @relation(fields: [agencyId, payableId], references: [agencyId, id], onDelete: Restrict, map: "payment_allocations_payable_tenant_fk")

  @@unique([agencyId, id], map: "payment_allocations_agency_id_key")
  @@index([agencyId, paymentId], map: "payment_allocations_agency_payment_idx")
  @@index([agencyId, receivableId], map: "payment_allocations_agency_receivable_idx")
  @@index([agencyId, payableId], map: "payment_allocations_agency_payable_idx")
  @@map("payment_allocations")
}

model OperationalCost {
  id                   String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId             String   @map("agency_id")
  saleId               String?  @map("sale_id")
  transportOperationId String?  @map("transport_operation_id")
  supplierId           String?  @map("supplier_id")
  description          String
  costType             String   @map("cost_type")
  expectedAmount       Decimal? @map("expected_amount") @db.Decimal(12, 2)
  actualAmount         Decimal? @map("actual_amount") @db.Decimal(12, 2)
  incurredAt           DateTime @map("incurred_at") @db.Timestamptz(6)
  createdBy            String   @map("created_by")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  agency             Agency              @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "operational_costs_agency_fk")
  sale               Sale?               @relation(fields: [agencyId, saleId], references: [agencyId, id], onDelete: Restrict, map: "operational_costs_sale_tenant_fk")
  transportOperation TransportOperation? @relation(fields: [agencyId, transportOperationId], references: [agencyId, id], onDelete: Restrict, map: "operational_costs_operation_tenant_fk")
  supplier           Supplier?           @relation(fields: [agencyId, supplierId], references: [agencyId, id], onDelete: Restrict, map: "operational_costs_supplier_tenant_fk")
  creator            User                @relation(fields: [agencyId, createdBy], references: [agencyId, id], onDelete: Restrict, map: "operational_costs_created_by_tenant_fk")
  payables           Payable[]

  @@unique([agencyId, id], map: "operational_costs_agency_id_key")
  @@index([agencyId, transportOperationId], map: "operational_costs_agency_operation_idx")
  @@index([agencyId, saleId], map: "operational_costs_agency_sale_idx")
  @@index([agencyId, incurredAt], map: "operational_costs_agency_incurred_idx")
  @@map("operational_costs")
}

model Trip {
  id          String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  agencyId    String     @map("agency_id")
  customerId  String     @map("customer_id")
  saleId      String?    @map("sale_id")
  name        String
  destination String
  description String?
  startDate   DateTime   @map("start_date") @db.Date
  endDate     DateTime   @map("end_date") @db.Date
  status      TripStatus @default(PLANNED)
  notes       String?
  metadata    Json?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  agency      Agency     @relation(fields: [agencyId], references: [id], onDelete: Restrict, map: "trips_agency_fk")
  customer    Customer   @relation(fields: [agencyId, customerId], references: [agencyId, id], onDelete: Restrict, map: "trips_customer_tenant_fk")
  // saleId is nullable: same SetNull-by-default risk noted above.
  // Explicit onDelete: Restrict here is required for accuracy.
  sale        Sale?      @relation(fields: [agencyId, saleId], references: [agencyId, id], onDelete: Restrict, map: "trips_sale_tenant_fk")

  @@unique([agencyId, saleId], map: "trips_agency_sale_key")
  @@index([agencyId, customerId], map: "trips_agency_customer_idx")
  @@index([agencyId], map: "trips_agency_idx")
  @@index([agencyId, startDate], map: "trips_agency_start_date_idx")
  @@index([agencyId, status], map: "trips_agency_status_idx")
  @@map("trips")
}

