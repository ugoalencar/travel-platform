{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd ../.. && npm install && npm run build --workspace=apps/customer",
  "outputDirectory": "dist",
  "installCommand": "echo 'handled by buildCommand (workspace install)'",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
