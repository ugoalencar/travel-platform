{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd ../.. && npm install && npm run build --workspace=apps/customer",
  "outputDirectory": "dist",
  "installCommand": "echo 'handled by buildCommand (workspace install)'",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://api.travelplataforma.com.br/$1" },
    { "source": "/customer-api/(.*)", "destination": "https://api.travelplataforma.com.br/customer-api/$1" },
    { "source": "/customer-auth/(.*)", "destination": "https://api.travelplataforma.com.br/customer-auth/$1" },
    { "source": "/invitations/(.*)", "destination": "https://api.travelplataforma.com.br/invitations/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
