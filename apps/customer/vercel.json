{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd ../.. && npm install && npm run build --workspace=apps/customer",
  "outputDirectory": "dist",
  "installCommand": "echo 'handled by buildCommand (workspace install)'",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://travel-platform-api-ugoalencars-projects.vercel.app/$1" },
    { "source": "/customer-api/(.*)", "destination": "https://travel-platform-api-ugoalencars-projects.vercel.app/customer-api/$1" },
    { "source": "/customer-auth/(.*)", "destination": "https://travel-platform-api-ugoalencars-projects.vercel.app/customer-auth/$1" },
    { "source": "/invitations/(.*)", "destination": "https://travel-platform-api-ugoalencars-projects.vercel.app/invitations/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
