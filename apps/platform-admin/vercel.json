{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd ../.. && npm install && npm run build --workspace=apps/platform-admin",
  "outputDirectory": "dist",
  "installCommand": "echo 'handled by buildCommand (workspace install)'",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://travel-platform-g0t9.onrender.com/$1" },
    { "source": "/platform-auth/(.*)", "destination": "https://travel-platform-g0t9.onrender.com/platform-auth/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
