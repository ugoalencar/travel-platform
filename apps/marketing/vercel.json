{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd ../.. && npm install && npm run build --workspace=apps/marketing",
  "outputDirectory": "dist",
  "installCommand": "echo 'handled by buildCommand (workspace install)'",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://api.travelplataforma.com.br/$1" },
    { "source": "/public/(.*)", "destination": "https://api.travelplataforma.com.br/public/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
