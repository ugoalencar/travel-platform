# ============================================================================
# TRAVEL PLATFORM — STAGING ENVIRONMENT VARIABLES (services/api)
# ============================================================================
# This lists ONLY the environment variables services/api actually reads
# today (verified against services/api/src/env.ts, dev-auth.ts, database.ts,
# rate-limit.ts -- grep `process\.env\.` / `environment\.` across
# services/api/src). .env.production.example at the repo root predates the
# real Bearer-session-token auth work and lists JWT_SECRET/COOKIE_* that
# nothing in services/api reads -- do not use it as the source of truth for
# auth-related vars; this file is.
#
# Set these in the Node host's dashboard (Render/Railway/Fly/etc), never
# committed. Vercel env vars for the 4 frontend apps are separate -- see
# docs/deployment/STAGING_DEPLOY_RUNBOOK.md.
# ============================================================================

# CRITICAL: must be "production", NOT "staging" -- every fail-closed
# safety gate in this codebase (DATABASE_URL required, ALLOW_DEV_AUTH
# blocked, RATE_LIMIT_STORE=external required, CORS_ALLOWED_ORIGINS
# required, superuser/BYPASSRLS DB-role check) is gated on the literal
# string comparison `NODE_ENV === 'production'` (env.ts, security-config.ts,
# rate-limit.ts). The repo-root Dockerfile sets `ENV NODE_ENV=staging` by
# default -- that value must be overridden to "production" on the actual
# host's environment variables, or none of these protections engage and
# this "staging" environment runs with production's safety net silently
# turned off. There is no separate "staging-safe" gate level in this code;
# staging must set NODE_ENV=production to get the same protections
# production will have.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Supabase (or any Postgres 15+) connection string. The runtime connects as
# a non-superuser, non-BYPASSRLS role -- assertSafeDatabaseRole() in env.ts
# refuses to start otherwise (RLS is the tenant-isolation backbone here).
# Supabase's default "postgres" user IS a superuser -- create a dedicated
# limited role for this connection string; see the runbook.
DATABASE_URL=postgresql://travel_app_runtime:__PASSWORD__@__SUPABASE_HOST__:5432/postgres

# Optional pool tuning (defaults shown are the code's own fallbacks).
# DB_POOL_MAX=20
# DB_POOL_IDLE_TIMEOUT=30000
# DB_POOL_CONNECTION_TIMEOUT=5000

# Distributed rate limiting: env.ts refuses to start in production unless
# this is "external" with a REDIS_URL set (in-memory rate limiting is
# explicitly a single-instance-only fallback, not safe in production).
RATE_LIMIT_STORE=external
REDIS_URL=rediss://default:__PASSWORD__@__UPSTASH_HOST__:6379

# Must be unset or "false" in production -- env.ts throws at startup if this
# is "true" (dev-only header-based auth bypass).
# ALLOW_DEV_AUTH=false

# Required in production (security-config.ts refuses to start without it):
# comma-separated, HTTPS-only, no wildcard. Set to the 4 Vercel app origins.
CORS_ALLOWED_ORIGINS=https://agency.__DOMAIN__,https://portal.__DOMAIN__,https://admin.__DOMAIN__,https://www.__DOMAIN__

# ============================================================================
# NOT YET WIRED -- flagged here so staging sign-off doesn't assume otherwise
# ============================================================================
# - No email/SMTP provider is implemented. customerForgotPassword() /
#   forgotPassword() (local-auth.ts, customer-local-auth.ts) generate and
#   store the reset token but never send it anywhere (see the
#   "no email provider wired yet" comment at each call site). The staging
#   acceptance criterion "EMAIL PASS" cannot pass until this is built --
#   this is real, unbuilt scope, not a config gap.
# - mfa_totp_secrets.secret_encrypted is stored and read as the raw base32
#   TOTP secret (services/api/src/local-auth.ts) -- confirmed no encryption
#   is actually applied anywhere in the code despite the column name; it is
#   plaintext in the database today. No MFA_ENCRYPTION_KEY (or similar) env
#   var exists to wire one up. Encrypting this at rest is real, unbuilt
#   scope, not a config gap -- flag before treating MFA as production-safe.
