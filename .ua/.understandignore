# .understandignore — patterns for files/dirs to exclude from analysis
# Syntax: same as .gitignore (globs, # comments, ! negation, trailing / for dirs)
# Built-in defaults (always excluded unless negated):
#   node_modules/, .git/, dist/, build/, obj/, *.lock, *.min.js, etc.

# --- Histórico/ruído da raiz (mantém docs oficiais) ---
/*.md
!README.md
!AGENTS.md
!QUALITY-GATES.md
!SCRIPTS.md
!AI-RULES.MD
/.implementation-status
/qa-report.json
/qa-test.js
/lint-output.txt

# --- Artefatos de sessão e QA ---
.claude/
.ai-research/
graphify-out/
**/graphify-out/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# --- Segredos e env real (exemplos continuam visíveis) ---
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
secrets/
secret/
credentials/

# --- Backups e gerados ---
backups/
*.sql.gz
*.sql.bak
dist.bak/
dist.bak.*/
dist.old*/
packages/database/generated/
prisma/generated/
test-results/
playwright-report/
coverage-final.json
**/vitest-report.json
.vite/
.tmp/
.tmp*/
