# ============================================================
# Travel Platform -- variáveis de ambiente
# Nenhum valor real deve ser commitado aqui. Este arquivo é o
# template; os valores reais vivem apenas no seu .env local ou nas
# variáveis de ambiente do Railway/Vercel (nunca no Git).
#
# Classificação (ver docs/release/PILOT_REMOTE_PROVISIONING_REPORT.md,
# Fase 9):
#   PUBLIC       -- pode ir no bundle do frontend (prefixo VITE_*)
#   SERVER_ONLY  -- só no processo da API (Railway); nunca no frontend
#   SECRET       -- server-only E sensível; nunca em log, nunca no Git
# ============================================================

# ---------------- Application (SERVER_ONLY) ----------------
NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# HOST: services/api/src/server.ts faz fallback para 127.0.0.1 quando
# ausente -- correto para dev local, mas QUEBRA em qualquer plataforma
# de container (Render/Railway/Fly): a plataforma só detecta portas
# abertas em 0.0.0.0, nunca em loopback. Obrigatório em produção/piloto.
HOST=0.0.0.0
# PORT: não precisa setar no Render/Railway -- a plataforma injeta
# automaticamente. Só é usado como fallback em dev local.
PORT=3000

# ---------------- Database (SECRET) ----------------
# Piloto: connection string do projeto Supabase PILOT (sa-east-1),
# usando a runtime role dedicada (NOBYPASSRLS, não superuser).
# Nunca compartilhar com o banco de DEMO.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# PLATFORM_DATABASE_URL (F-06): connection da role de plataforma (superset
# da runtime: tabelas de plataforma SEM RLS + tabelas tenant). Em produção é
# OBRIGATÓRIO e precisa ser diferente de DATABASE_URL -- depois da migration
# 095_platform_role_separation.sql a runtime role perdeu os grants das
# tabelas de plataforma (platform_users, platform_sessions, billing_* etc.).
# Em dev local, se ausente, cai no mesmo DATABASE_URL (role única).
PLATFORM_DATABASE_URL=

# ---------------- Authentication (SECRET) ----------------
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
COOKIE_NAME=travel_platform_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# MFA_ENCRYPTION_KEY (services/api/src/mfa-encryption.ts): mínimo 32
# caracteres, usado para cifrar segredos TOTP em repouso (AES-256-GCM).
# Gerar um valor novo e exclusivo para o piloto -- nunca reaproveitar
# o valor de DEMO/local.
MFA_ENCRYPTION_KEY=replace-with-a-random-32-plus-character-secret

# ---------------- Tenant context (SERVER_ONLY) ----------------
TENANT_CONTEXT_SETTING=app.current_agency_id
USER_CONTEXT_SETTING=app.current_user_id

# ---------------- Observability (SERVER_ONLY) ----------------
LOG_LEVEL=info

# ---------------- Rate limiting (SERVER_ONLY) ----------------
# Em produção/piloto, RATE_LIMIT_STORE deve ser "external" com
# REDIS_URL configurado (services/api/src/rate-limit.ts é fail-closed:
# recusa iniciar em produção sem Redis real quando "external").
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE=memory
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# ---------------- Redis / Upstash (SECRET) ----------------
# Usar rediss:// (TLS) para o piloto. Deixe vazio em desenvolvimento
# local (RATE_LIMIT_STORE=memory não precisa disso).
REDIS_URL=

# ---------------- CORS (SERVER_ONLY) ----------------
# services/api/src/security-config.ts é fail-closed em produção: recusa
# iniciar sem esta lista, recusa "*", recusa origem não-HTTPS. Lista
# separada por vírgula, sem espaços, sem path.
CORS_ALLOWED_ORIGINS=https://travelplataforma.com.br,https://app.travelplataforma.com.br,https://cliente.travelplataforma.com.br,https://admin.travelplataforma.com.br

# ---------------- Resend / E-mail (SECRET) ----------------
# services/api/src/email/factory.ts: sem RESEND_API_KEY + EMAIL_FROM,
# cai no provider "unconfigured" (falha) em NODE_ENV=production/staging.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# EMAIL_REQUIRE_REAL=true força o provider real mesmo fora de
# production/staging (útil para validar Resend em ambientes intermediários).
EMAIL_REQUIRE_REAL=false

# ---------------- Storage (object store) ----------------
# STORAGE_PROVIDER: "local" (disco, fora de production) ou "supabase".
# Em production é OBRIGATÓRIO: "local" exige UPLOADS_DIR apontando para um
# volume persistente; "supabase" exige SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.
STORAGE_PROVIDER=
# UPLOADS_DIR=/var/data/uploads
# services/api/src/supabase-storage.ts. SUPABASE_SERVICE_ROLE_KEY
# NUNCA vai para o frontend -- só o backend (Railway) usa.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------- Frontend (PUBLIC -- vai no bundle Vite) ----------------
# Definido no painel de cada projeto Vercel (agency/customer/marketing/
# platform-admin), não neste .env do backend. Documentado aqui só para
# inventário. Substitui o placeholder __API_ORIGIN__ usado nos
# apps/*/vercel.json (rewrites de /api/*) no momento do deploy.
VITE_API_BASE_URL=https://api.travelplataforma.com.br
